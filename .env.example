# Every variable is optional; see "Configuration" in the README.

# --- Paid downloads (all three unset: downloads are free) ---
# The Solana wallet that gets paid
PAY_WALLET=
# Any long random string that signs price quotes: openssl rand -hex 32
PAY_SECRET=
# Price of one download in dollars (default 1)
PAY_PRICE_USD=1
# The owner's free-download key, 16+ random characters: openssl rand -hex 16
# Then open https://your-site/owner/?key=<OWNER_KEY> once per browser
OWNER_KEY=

# --- Data sources ---
# Your own Solana RPC (recommended in production, also used to check payments)
SOLANA_RPC_URL=
ETHERSCAN_API_KEY=
NEXT_PUBLIC_SITE_URL=
